# Required for Gemini-backed features
GEMINI_API_KEY=your_api_key_here

# Current Gemini model. Change this if your Google AI Studio account exposes another model.
GEMINI_MODEL=gemini-3.8-flash

# Optional local concept explanation using LaMini-Flan-T5-783M.
# Set true only after installing requirements-local.txt.
ENABLE_LOCAL_EXPLANATION=false
LOCAL_MODEL_NAME=MBZUAI/LaMini-Flan-T5-783M

APP_NAME=EduGenie
ENVIRONMENT=development
REQUEST_TIMEOUT_SECONDS=60
MAX_INPUT_CHARS=12000
